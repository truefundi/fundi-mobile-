# Copy this file to .env, then restart Expo (`npx expo start -c`) after any change:
# EXPO_PUBLIC_* values are baked into the bundle when it is built.

# REQUIRED. Fundi API origin. Every API call fails with "Set EXPO_PUBLIC_API_URL" without it.
# - Web in this computer's browser: http://localhost:3000
# - Physical phone or emulator: your computer's Wi-Fi IPv4 address, e.g. http://192.168.1.20:3000
#   (the phone and computer must be on the same network; `localhost` on a phone is the phone).
# Do not append /api; API paths include their own prefix.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Optional. Fundi mobile money merchant codes shown at checkout ("Pay with mobile money").
# Leave blank and that option shows as not configured yet.
EXPO_PUBLIC_MTN_MOMO_PAY_CODE=
EXPO_PUBLIC_AIRTEL_MONEY_PAY_CODE=

# Optional, only for the static web build (scripts/build.js and server/serve.js).
# Not needed for `npx expo start`.
# BASE_PATH=/              # sub-path the web build is served under
# EXPO_PUBLIC_DOMAIN=      # public domain of the built app, without https://
# PORT=3000                # port server/serve.js listens on
# REPLIT_* and REPL_ID are set automatically when hosted on Replit; do not set them here.
